{
  "name": "motion",
  "private": true,
  "type": "module",
  "description": "hush — 15s launch promo, rendered from code (React scenes + synthesized score).",
  "scripts": {
    "audio": "uv run audio/score.py",
    "stills": "node scripts/render.mjs --stills",
    "render": "node scripts/render.mjs",
    "build": "npm run audio && npm run render",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.12.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
